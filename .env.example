# Copy to .env for local development. Real environment variables take
# precedence over the values in this file.

# Local development runs against the SQLite file at backend/data/percursos.db,
# created automatically (file + schema) on first launch if it does not exist.

# "development" locally; docker-compose defaults deployed environments to "production".
PERCURSOS_ENV=development

PERCURSOS_SECRET_KEY=change-me-to-a-long-random-string

# Production hook: URL of the external database (e.g. PostgreSQL). Leave unset
# in local development to use the auto-created SQLite file.
# PERCURSOS_DATABASE_URL_OVERRIDE=postgresql+psycopg://user:pass@host:5432/percursos

# Default admin seeded on first launch (only when the database has no users).
# PERCURSOS_DEFAULT_ADMIN_USERNAME=admin
# PERCURSOS_DEFAULT_ADMIN_PASSWORD=pass

# Retention days for automatic weekly backups
# PERCURSOS_BACKUP_RETENTION_DAYS=30

# Session cookie Secure flag: automatic by default — enabled when
# PERCURSOS_ENV=production. Set "true"/"false" explicitly to override.
# (docker-compose defaults this to true in deployed environments.)
# PERCURSOS_SESSION_COOKIE_SECURE=true

# Comma-separated hostnames the backend answers to (TrustedHostMiddleware);
# "*" (the default) accepts any Host header. Set to the public hostname(s)
# in production.
# PERCURSOS_ALLOWED_HOSTS=percurso.example.com

# Web Push (VAPID) keys. Generate with: python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print(v.private_pem().decode())"
# and the matching public PEM via v.public_pem(). Leave both unset to disable push notifications.
# Use double quotes and escaped \n sequences for the PEM (one physical line).
# The subject must be a real contact address; a missing/placeholder subject
# (e.g. the built-in .local default) disables push instead of sending with a
# bogus contact.
# PERCURSOS_VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# PERCURSOS_VAPID_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# PERCURSOS_VAPID_SUBJECT="mailto:you@example.com"

# CARTO basemaps API key (dark map tiles). Free tier: request with just an
# e-mail at https://carto.com/basemap-terms/ (docs: carto.com/basemaps) —
# no account, no card. Leaves the keyless URLs in place until unset.
# PERCURSOS_CARTO_TILES_KEY=""
